{
  "title": "트리거 독해",
  "intro": "문장에서 보이는 모양을 먼저 읽고, 나중에 문법 이름을 붙입니다. 처음부터 가도 되고, 궁금한 부분만 골라도 됩니다.",
  "chapters": [
    {
      "id": "01",
      "title": "문장 성분",
      "docent": [
        {
          "role": "독해",
          "text": "영어 문장은 이름보다 먼저, 보이는 모양으로 읽습니다.\n\n지금부터 그 모양을 하나씩 볼게요."
        },
        {
          "role": "세 가지 모양",
          "text_parts": [
            {
              "text": "영어 문장은 큰 모양이 세 가지입니다.\n\n"
            },
            {
              "text": "① 누가 · (되다) · 무엇이\n② 누가 · -하다 · 무엇을\n③ 누가 · -하다 · 무엇을 · ~하게/으로",
              "mark": "forms"
            }
          ]
        },
        {
          "role": "이름 붙이기",
          "text_parts": [
            {
              "text": "나중에 이 모양들에 이름을 붙입니다.\n\n"
            },
            {
              "text": "주어",
              "mark": "s"
            },
            {
              "text": " · "
            },
            {
              "text": "서술어",
              "mark": "v"
            },
            {
              "text": " · "
            },
            {
              "text": "목적어",
              "mark": "o"
            },
            {
              "text": " · "
            },
            {
              "text": "보어",
              "mark": "c"
            },
            {
              "text": ".\n\n지금은 모양부터 익히면 됩니다."
            }
          ]
        }
      ],
      "docent_bridge": "그중 가장 많이 보는 모양부터 볼게요.\n누가 · -하다 · 무엇을",
      "patterns": [
        {
          "id": "svo",
          "title": "주·동·목",
          "formula": "누가 · -하다 · 무엇을",
          "ready": true
        },
        {
          "id": "svc",
          "title": "주·동·보",
          "formula": "누가 · (되다) · 무엇이",
          "ready": true
        },
        {
          "id": "svoc",
          "title": "주·동·목·보",
          "formula": "누가 · -하다 · 무엇을 · ~하게/으로",
          "ready": true
        }
      ]
    },
